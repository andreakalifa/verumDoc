.ruff_cache/

# Env files
.env
.env.*
!.env.example

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Docker
*.log

# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
